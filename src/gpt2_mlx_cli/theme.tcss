Screen {
    background: #111111;
    color: #eeeeee;
    layout: vertical;
    padding: 0 2;
}

* {
    scrollbar-color: #494949;
    scrollbar-color-hover: #69dfca;
    scrollbar-color-active: #69dfca;
    scrollbar-background: #111111;
    scrollbar-size: 1 1;
}

#header {
    height: 3;
    padding: 1 0;
}

#brand {
    width: 1fr;
    color: #69dfca;
    text-style: none;
}

#context {
    width: auto;
    color: #a0a0a0;
    text-align: right;
}

#transcript {
    height: 1fr;
    overflow-x: hidden;
}

#welcome {
    padding: 2 1;
    color: #888888;
}

.turn {
    height: auto;
    margin: 0 0 1 0;
}

.user {
    background: #252525;
    padding: 1;
}

.user-band {
    height: auto;
}

.message-body {
    height: auto;
    width: 1fr;
}

.timestamp {
    width: 6;
    text-align: right;
    color: #929292;
}

.assistant {
    padding: 0 1 1 1;
    background: #111111;
    color: #eeeeee;
}

#bottom {
    height: auto;
    padding: 0 0 1 0;
}

#status {
    height: auto;
    max-height: 3;
    color: #a0a0a0;
    margin: 0 0 1 0;
}

.error, #settings-error, #sessions-error {
    color: #f0a69b;
}

#composer {
    height: 5;
    border: round #505050;
    background: #111111;
    color: #eeeeee;
    padding: 0 1;
}

#composer:focus {
    border: round #69dfca;
}

#composer > .text-area--cursor {
    background: #69dfca;
    color: #111111;
}

#controls {
    height: 1;
    margin: 0 0 1 0;
}

#session-mode {
    width: 1fr;
    color: #888888;
}

Button {
    min-width: 7;
    height: 1;
    border: none;
    background: #252525;
    color: #d8d8d8;
    text-style: none;
    margin-left: 1;
    padding: 0 1;
}

Button.-primary {
    background: #69dfca;
    color: #111111;
}

Button.-error {
    background: #5d2929;
    color: #f0a69b;
}

Button:hover, Button:focus {
    background: #a2f0e1;
    color: #111111;
    text-style: none;
}

Button:disabled {
    background: #171717;
    color: #555555;
}

#shortcuts {
    height: auto;
    color: #8b8b8b;
}

.narrow {
    padding: 0 1;
}

.narrow #header {
    layout: vertical;
    height: 4;
}

.narrow #brand, .narrow #context {
    height: 1;
    width: 100%;
    text-align: left;
}

.short #header {
    padding-top: 0;
    padding-bottom: 0;
    height: 1;
}

.short.narrow #header {
    height: 2;
}

.short #composer {
    height: 4;
}

.short #bottom {
    padding-bottom: 0;
}

.short #status, .short #controls {
    margin-bottom: 0;
}

.short #status {
    height: 1;
    max-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ModalScreen {
    align: center middle;
    background: #000000 65%;
    padding: 0 1;
}

.dialog {
    width: 60;
    max-width: 100%;
    max-height: 95%;
    border: round #505050;
    background: #191919;
    padding: 1 2;
}

.dialog-title {
    height: 2;
    color: #69dfca;
}

#settings-dialog {
    height: 36;
}

#settings-fields {
    height: 1fr;
    min-height: 3;
}

.field-label {
    height: 1;
    color: #aaaaaa;
}

Input, Select {
    margin: 0 0 1 0;
    background: #252525;
    border: tall #343434;
}

Input:focus, Select:focus {
    border: tall #69dfca;
}

#settings-error, #sessions-error {
    height: auto;
    max-height: 3;
}

.dialog-actions {
    height: 1;
    margin-top: 1;
    align-horizontal: right;
}

#sessions-dialog {
    height: 24;
}

#session-list {
    height: 1fr;
    border: none;
    background: #191919;
    margin-bottom: 1;
}

#empty-sessions {
    height: 1fr;
    color: #aaaaaa;
}

#delete-session-dialog {
    height: auto;
}

#delete-session-title {
    height: auto;
    max-height: 2;
    text-overflow: ellipsis;
    margin-bottom: 1;
}

#delete-session-warning {
    height: auto;
    color: #aaaaaa;
}

#quit-dialog, #quit-actions {
    height: auto;
}

#quit-save-error {
    height: auto;
    max-height: 3;
    color: #f0a69b;
    margin-bottom: 1;
}

#quit-actions Button {
    width: 100%;
    margin-left: 0;
}
